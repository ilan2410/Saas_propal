# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic Claude API
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
CLAUDE_MODEL_EXTRACTION=claude-sonnet-5-5

# Stripe Configuration
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Application URL
NEXT_PUBLIC_URL=http://localhost:3000

# Calendar integrations
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
CALENDAR_TOKEN_ENCRYPTION_KEY=
CALENDAR_OAUTH_STATE_SECRET=
CALENDAR_CRON_SECRET=

# Proposition attachments (new uploads only)
ATTACHMENTS_STORAGE_PROVIDER=supabase
ATTACHMENTS_S3_ENDPOINT=
ATTACHMENTS_S3_REGION=
ATTACHMENTS_S3_BUCKET=
ATTACHMENTS_S3_ACCESS_KEY_ID=
ATTACHMENTS_S3_SECRET_ACCESS_KEY=
ATTACHMENTS_S3_FORCE_PATH_STYLE=false

# Resend (tous les emails transactionnels : inscription, reset mot de passe)
RESEND_API_KEY=
# Expéditeur sur un domaine vérifié dans Resend, ex: PropoBoost <no-reply@mail.mondomaine.fr>
RESEND_FROM_EMAIL=
# Optionnel : adresse de réponse
RESEND_REPLY_TO=

# Formulaire de contact : adresse qui reçoit les demandes (défaut : contact@concept.livenot.net)
CONTACT_RECEIVER_EMAIL=contact@concept.livenot.net
